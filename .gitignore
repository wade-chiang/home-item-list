# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage

# production
/dist

# PocketBase：資料與照片（pb_data）、前端 build 產物（pb_public）都不進 git
# pb_migrations/ 刻意「不」排除：它是 schema 唯一的版本化紀錄（CLAUDE.md 紀律 3）
/pb_data/
/pb_public/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
pnpm-debug.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# 個人的 shell 與編輯器設定檔，不屬於專案。
# 沙箱會把這些路徑掛成空檔，在沙箱內 git add 會被誤收（commit 55b93e1 就收進了 22 個空檔）。
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.ripgreprc
/.idea
/.vscode
# 刻意「不」排除 .claude/、.mcp.json、.gitmodules：專案之後可能真的需要放設定。
# commit 時請明確指定檔案（例如 git add CLAUDE.md docs/），不要用 git add -A。
